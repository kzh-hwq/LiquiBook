# Sao chép file này thành .env rồi điền thông tin thật. KHÔNG đưa .env lên GitHub.
# Tên đăng nhập là SỐ LƯU KÝ của tài khoản chứng khoán VPBankS
NEO_USERNAME=
NEO_PASSWORD=
NEO_AUTH_URL=https://external.vpbanks.com.vn/auth/token
NEO_WS_URL=wss://neoapi.vpbanks.com.vn/stock-stream/broker
# Danh sách mã, cách nhau dấu phẩy, không có khoảng trắng (ví dụ rổ VN30)
NEO_SYMBOLS=VCB,HPG,FPT
NEO_INDEXES=VNINDEX,VN30
NEO_MARKETS=HOSE
